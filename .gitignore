# Create .gitignore if it doesn't exist
cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
.Python

# Spark
spark/checkpoints/*
spark/models/random_forest_energy/*
!spark/models/.gitkeep
*.parquet
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# Docker volumes
mongodb_data/
postgres_data/
grafana_data/
ivy_cache/

# OS
.DS_Store
Thumbs.db

# Environment
.env
*.env

# Large files
*.csv
!spark/training_energy.csv
EOF

# Add .gitignore
git add .gitignore